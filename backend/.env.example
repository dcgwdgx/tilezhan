# TileZhan Backend — Environment Variables
# Copy to .env and fill in values

# App
APP_NAME="TileZhan API"
APP_VERSION="1.0.0"
APP_ENV=development
DEBUG=true

# Local-only switch. Keep false in production; production startup rejects true.
ALLOW_DEV_AUTH_BYPASS=false

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIRESTORE_DATABASE=(default)

# RevenueCat
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=

# Redis (for Celery background tasks)
REDIS_URL=redis://localhost:6379/0

# Security
RATE_LIMIT_PER_MINUTE=100
ALLOWED_ORIGINS=["https://tilezhan.app"]
